# Supabase persistence (leave both unset to use local JSON files)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# For legacy projects only, use the service_role key instead of SUPABASE_SECRET_KEY.
# Never use a publishable/anon key for server-side storage.
# SUPABASE_SERVICE_ROLE_KEY=

# Twilio settings are configured in the app's Settings dialog.
