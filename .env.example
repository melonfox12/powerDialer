# Supabase persistence (leave both unset to use local JSON files)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# For legacy projects only, use the service_role key instead of SUPABASE_SECRET_KEY.
# Never use a publishable/anon key for server-side storage.
# SUPABASE_SERVICE_ROLE_KEY=

# Twilio settings are configured in the app's Settings dialog.

# Optional dialer preferences (also editable in Settings; these are the defaults)
SESSION_GOAL=20
CONVERSATION_THRESHOLD_SECONDS=30
AUTO_ADVANCE_DELAY_SECONDS=3
SOUNDS_ENABLED=true
SOUND_VOLUME=35
BREAK_NUDGE_MINUTES=90
CALLING_START_HOUR=8
CALLING_END_HOUR=21
